st-packages (from pydantic!=2.0.*,!=2.1.*,!=2.2.*,!=2.3.*,<3,>=1.10.13->openai>=1.0) (0.4.2)\nDownloading openai-3.19.2-py3-none-any.whl (2.1 MB)\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m2.1/2.1 MB\u001b[0m \u001b[31m22.8 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m00:01\u001b[0m00:01\u001b[0m\n\u001b[?25hDownloading httpx2-2.13.1-py3-none-any.whl (95 kB)\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m95.6/95.6 kB\u001b[0m \u001b[31m3.2 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25hDownloading httpcore2-2.13.1-py3-none-any.whl (83 kB)\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m83.4/83.4 kB\u001b[0m \u001b[31m3.1 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25hDownloading jiter-0.17.0-cp312-cp312-manylinux_2_17_x86_64.manylinux2014_x86_64.whl (345 kB)\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m345.0/345.0 kB\u001b[0m \u001b[31m10.5 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25hDownloading idna-3.20-py3-none-any.whl (69 kB)\n\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m69.6/69.6 kB\u001b[0m \u001b[31m2.5 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25hDownloading truststore-0.10.4-py3-none-any.whl (18 kB)\nInstalling collected packages: truststore, jiter, idna, httpcore2, httpx2, openai\n  Attempting uninstall: jiter\n    Found existing installation: jiter 0.10.0\n    Uninstalling jiter-0.10.0:\n      Successfully uninstalled jiter-0.10.0\n  Attempting uninstall: idna\n    Found existing installation: idna 3.13\n    Uninstalling idna-3.13:\n      Successfully uninstalled idna-3.13\n  Attempting uninstall: openai\n    Found existing installation: openai 2.32.0\n    Uninstalling openai-2.32.0:\n      Successfully uninstalled openai-2.32.0\n\u001b[31mERROR: pip's dependency resolver does not currently take into account all the packages that are installed. This behaviour is the source of the following dependency conflicts.\ngoogle-adk 1.29.0 requires google-cloud-bigquery-storage>=2.0.0, which is not installed.\u001b[0m\u001b[31m\n\u001b[0mSuccessfully installed httpcore2-2.13.1 httpx2-2.13.1 idna-3.20 jiter-0.17.0 openai-3.19.2 truststore-0.10.4\nNote: you may need to restart the kernel to use updated packages.\n","output_type":"stream"}],"execution_count":1},{"id":"89d22c2e-e705-48ff-a96c-5a6a76c2d5b7","cell_type":"code","source":"from openai import OpenAI\n\n# Initialize the Openai client to read your API Key from the environment variable\nclient = OpenAI(\n    # This is the default path. You can configure it based on the service location\n    base_url=\"https://ark.ap-southeast.bytepluses.com/api/v3\",\n    # Get your API Key from the environment variable\n    api_key=\""\n)\n\nGENERATOR_MODEL = \"deepseek-v4-1-flash-260910\"\nJUDGE_MODEL = \"seed-2-0-mini-260428\"\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T08:33:37.96933Z","iopub.execute_input":"2026-09-25T08:33:37.969661Z","iopub.status.idle":"2026-09-25T08:33:37.975545Z","shell.execute_reply.started":"2026-09-25T08:33:37.969633Z","shell.execute_reply":"2026-09-25T08:33:37.974698Z"}},"outputs":[],"execution_count":10},{"id":"fd61f68f-a814-481b-a8e5-e257098d84fc","cell_type":"code","source":"import re, os, json\n\n# ---------- LAYER 1: CODE (deterministic regex/keyword) ----------\ndef layer1_code(prediction: str, must_not_contain: list[str] = None, must_contain: list[str] = None):\n    \"\"\"\n    Cheap deterministic check. Returns (caught: 1/0, reasoning: str).\n    caught=1 means the FAILURE was caught (i.e. eval correctly flags a bad prediction).\n    \"\"\"\n    must_not_contain = must_not_contain or []\n    must_contain = must_contain or []\n    hits = [term for term in must_not_contain if re.search(re.escape(term), prediction, re.IGNORECASE)]\n    misses = [term for term in must_contain if not re.search(re.escape(term), prediction, re.IGNORECASE)]\n    if hits:\n        return 1, f\"Flagged forbidden term(s) present: {hits}\"\n    if misses:\n        return 1, f\"Flagged missing required term(s): {misses}\"\n    return 0, \"No keyword/regex rule fired -- Layer 1 passes this case through.\"\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T08:30:20.70886Z","iopub.execute_input":"2026-09-25T08:30:20.709284Z","iopub.status.idle":"2026-09-25T08:30:20.715729Z","shell.execute_reply.started":"2026-09-25T08:30:20.709255Z","shell.execute_reply":"2026-09-25T08:30:20.714894Z"}},"outputs":[],"execution_count":6},{"id":"fa5be6a7-900e-47f7-919e-b9ac8a95ab8e","cell_type":"markdown","source":"## Layer 2 -- Safety gate","metadata":{}},{"id":"c8bd1d42-2668-4f6c-bed7-888a3bc46271","cell_type":"code","source":"import re\n# ---------- LAYER 2: SAFETY (mandated-refusal / confidential-leak gate) ----------\nCONFIDENTIAL_MARKERS = [\"internal only\", \"do not share\", \"unreleased\", \"confidential\", \"roadmap (draft)\"]\nREFUSAL_TRIGGER_TOPICS = [\"unannounced pricing\", \"unreleased feature\", \"internal roadmap\", \"security incident details\"]\n\ndef layer2_safety(query: str, prediction: str):\n    \"\"\"\n    Gate check: should this query have triggered a mandated refusal, and did the\n    prediction leak something it shouldn't have?\n    Returns (caught: 1/0, reasoning: str).\n    \"\"\"\n    leaked = [m for m in CONFIDENTIAL_MARKERS if m.lower() in prediction.lower()]\n    should_have_refused = any(t.lower() in query.lower() for t in REFUSAL_TRIGGER_TOPICS)\n    if leaked:\n        return 1, f\"Confidential marker(s) leaked in prediction: {leaked}\"\n    if should_have_refused and \"i can't share\" not in prediction.lower() and \"i'm not able to share\" not in prediction.lower():\n        return 1, f\"Query matched a mandated-refusal topic but prediction did not refuse.\"\n    return 0, \"No safety/refusal gate fired -- Layer 2 passes this case through.\"\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T08:31:03.770589Z","iopub.execute_input":"2026-09-25T08:31:03.771691Z","iopub.status.idle":"2026-09-25T08:31:03.778292Z","shell.execute_reply.started":"2026-09-25T08:31:03.771654Z","shell.execute_reply":"2026-09-25T08:31:03.777377Z"}},"outputs":[],"execution_count":7},{"id":"4e1b12e4-6150-42e3-8973-a45319cd28af","cell_type":"markdown","source":"## Layer 3 -- Judge (semantic LLM-as-Judge)","metadata":{}},{"id":"bd1a2d40-5b1e-42ff-bf00-7114d81b6d1f","cell_type":"code","source":"import os, json\n# ---------- LAYER 3: JUDGE (semantic LLM-as-Judge) ----------\nJUDGE_RUBRIC = \"\"\"\nYou are grading whether PREDICTION is factually grounded in REFERENCE for the QUERY.\nScore 1 (FAIL / hallucination caught) if PREDICTION contradicts REFERENCE on any factual claim\n(price, capability, compliance status, etc.), even if fluent and confident-sounding.\nScore 0 (PASS) if PREDICTION is consistent with REFERENCE.\nRespond as JSON: {\"caught\": 0 or 1, \"reasoning\": \"...\"}\n\"\"\"\n\ndef judge(query: str, prediction: str, reference: str, rubric: str = JUDGE_RUBRIC):\n    \"\"\"\n    Real version calls an LLM. Requires OPENAI_API_KEY in your local .env.\n    Falls back to a clearly-labeled MOCK heuristic when no key is present so the\n    notebook still runs top-to-bottom without a key (per lab instructions).\n    \"\"\"\n\n    # --- MOCK fallback: naive semantic diff, NOT a substitute for the real judge ---\n    ref_nums = set(re.findall(r\"\\$?\\d+(?:\\.\\d+)?\", reference))\n    pred_nums = set(re.findall(r\"\\$?\\d+(?:\\.\\d+)?\", prediction))\n    if ref_nums and pred_nums and ref_nums != pred_nums:\n        return 1, f\"[MOCK JUDGE] Numeric claim mismatch -- reference has {ref_nums}, prediction has {pred_nums}.\"\n    return 0, \"[MOCK JUDGE] No numeric/keyword contradiction detected (no key set -- run with OPENAI_API_KEY for a real semantic read).\"\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T08:34:18.122496Z","iopub.execute_input":"2026-09-25T08:34:18.123307Z","iopub.status.idle":"2026-09-25T08:34:18.129549Z","shell.execute_reply.started":"2026-09-25T08:34:18.123274Z","shell.execute_reply":"2026-09-25T08:34:18.128137Z"}},"outputs":[],"execution_count":13},{"id":"5346cbb6-58da-4cdd-b16e-bfa6415cb24a","cell_type":"markdown","source":"## Demo: generic Cortex traces (illustrates the 3-layer mental model)\n\nThree synthetic cases, **not your P0** -- just to see the pattern before you score your own case:\n- Case A: Layer 1 catches it (**the Win**)\n- Case B: only Layer 3 catches it (**the Insight**)\n- Case C: nothing catches it (**the Gap**)","metadata":{}},{"id":"8dc302fc-c216-4b09-8568-4cfa7cebc8d0","cell_type":"code","source":"\n# Generic Cortex demo traces -- illustrate the 3-layer mental model before\n# scoring your own P0 case. These are NOT your case; they're synthetic.\ndemo_cases = [\n    {\n        \"name\": \"Case A -- 'the Win' (Layer 1 catches it)\",\n        \"query\": \"Does Ascend IQ support exporting raw event data as CSV?\",\n        \"prediction\": \"Yes, Ascend IQ supports native SQL export for all plans.\",\n        \"reference\": \"Ascend IQ does not support native SQL export on any plan; CSV export is available on Pro+.\",\n        \"l1_args\": {\"must_not_contain\": [\"native SQL export\"]},\n    },\n    {\n        \"name\": \"Case B -- 'the Insight' (only Layer 3 catches it)\",\n        \"query\": \"Is Ascend IQ SOC2 Type II certified?\",\n        \"prediction\": \"Ascend IQ has completed its SOC2 Type II audit and is fully certified.\",\n        \"reference\": \"Ascend IQ is SOC2 Type I certified; Type II audit is in progress, expected Q1.\",\n        \"l1_args\": {},  # no keyword rule anticipates this phrasing\n    },\n    {\n        \"name\": \"Case C -- 'the Gap' (nothing catches it)\",\n        \"query\": \"Does Enterprise onboarding include a dedicated Customer Success Manager?\",\n        \"prediction\": \"Enterprise onboarding is self-serve; customers configure everything themselves via the setup wizard.\",\n        \"reference\": \"Enterprise onboarding includes a dedicated CSM for the first 90 days, plus white-glove data migration support.\",\n        \"l1_args\": {},\n    },\n]\n\nfor case in demo_cases:\n    print(\"=\" * 70)\n    print(case[\"name\"])\n    print(f\"QUERY: {case['query']}\")\n    print(f\"PREDICTION: {case['prediction']}\")\n    print(f\"REFERENCE: {case['reference']}\")\n    l1_caught, l1_reason = layer1_code(case[\"prediction\"], **case[\"l1_args\"])\n    l2_caught, l2_reason = layer2_safety(case[\"query\"], case[\"prediction\"])\n    l3_caught, l3_reason = judge(case[\"query\"], case[\"prediction\"], case[\"reference\"])\n    print(f\"  Layer 1 (Code)   -> caught={l1_caught} | {l1_reason}\")\n    print(f\"  Layer 2 (Safety) -> caught={l2_caught} | {l2_reason}\")\n    print(f\"  Layer 3 (Judge)  -> caught={l3_caught} | {l3_reason}\")\nprint(\"=\" * 70)\n","metadata":{},"outputs":[{"output_type":"stream","name":"stdout","text":["======================================================================\n","Case A -- 'the Win' (Layer 1 catches it)\n","QUERY: Does Ascend IQ support exporting raw event data as CSV?\n","PREDICTION: Yes, Ascend IQ supports native SQL export for all plans.\n","REFERENCE: Ascend IQ does not support native SQL export on any plan; CSV export is available on Pro+.\n","  Layer 1 (Code)   -> caught=1 | Flagged forbidden term(s) present: ['native SQL export']\n","  Layer 2 (Safety) -> caught=0 | No safety/refusal gate fired -- Layer 2 passes this case through.\n","  Layer 3 (Judge)  -> caught=0 | [MOCK JUDGE] No numeric/keyword contradiction detected (no key set -- run with OPENAI_API_KEY for a real semantic read).\n","======================================================================\n","Case B -- 'the Insight' (only Layer 3 catches it)\n","QUERY: Is Ascend IQ SOC2 Type II certified?\n","PREDICTION: Ascend IQ has completed its SOC2 Type II audit and is fully certified.\n","REFERENCE: Ascend IQ is SOC2 Type I certified; Type II audit is in progress, expected Q1.\n","  Layer 1 (Code)   -> caught=0 | No keyword/regex rule fired -- Layer 1 passes this case through.\n","  Layer 2 (Safety) -> caught=0 | No safety/refusal gate fired -- Layer 2 passes this case through.\n","  Layer 3 (Judge)  -> caught=1 | [MOCK JUDGE] Numeric claim mismatch -- reference has {'2', '1'}, prediction has {'2'}.\n","======================================================================\n","Case C -- 'the Gap' (nothing catches it)\n","QUERY: Does Enterprise onboarding include a dedicated Customer Success Manager?\n","PREDICTION: Enterprise onboarding is self-serve; customers configure everything themselves via the setup wizard.\n","REFERENCE: Enterprise onboarding includes a dedicated CSM for the first 90 days, plus white-glove data migration support.\n","  Layer 1 (Code)   -> caught=0 | No keyword/regex rule fired -- Layer 1 passes this case through.\n","  Layer 2 (Safety) -> caught=0 | No safety/refusal gate fired -- Layer 2 passes this case through.\n","  Layer 3 (Judge)  -> caught=0 | [MOCK JUDGE] No numeric/keyword contradiction detected (no key set -- run with OPENAI_API_KEY for a real semantic read).\n","======================================================================\n"]}],"execution_count":1},{"id":"5db956a3-bb25-4583-8982-1a1488641b71","cell_type":"markdown","source":"## Your P0 case -- InsightFlow Enterprise pricing hallucination (scored)\n\nFrom the M2 failure taxonomy: **Rank 1, Trust Tag `#HALLUCINATION`, Severity P0** -- Enterprise pricing hallucination ($49 vs $59).","metadata":{}},{"id":"0c402b95-f61c-45de-b633-15fe61ea59a8","cell_type":"code","source":"# ============================================================\n# YOUR P0 CASE -- InsightFlow Enterprise pricing hallucination\n# Carried from M2 failure taxonomy: Rank 1, #HALLUCINATION, Severity P0\n# ============================================================\nP0_QUERY = \"What is InsightFlow's pricing for Enterprise?\"\nP0_PREDICTION = \"InsightFlow Enterprise starts at $49/user/month with a 10-seat minimum.\"\nP0_REFERENCE = \"Source: Pricing Page (Cached). Old Price: $49/mo. New Price (Updated yesterday): $59/mo.\"\n\nl1_caught, l1_reason = layer1_pricing_guard(P0_PREDICTION, P0_REFERENCE)\nl2_caught, l2_reason = layer2_safety(P0_QUERY, P0_PREDICTION)\n\n# Layer 3 judge result below is from a LIVE run (learner's own key, run locally) -- pasted in as ground truth\nl3_caught = 1\nl3_reason = (\"[LIVE JUDGE] The prediction incorrectly states InsightFlow's Enterprise pricing is $49/user/month, \"\n             \"while the reference specifies the updated price is $59/user/month, making the prediction factually wrong.\")\n\nprint(f\"QUERY: {P0_QUERY}\")\nprint(f\"PREDICTION: {P0_PREDICTION}\")\nprint(f\"REFERENCE: {P0_REFERENCE}\")\nprint(f\"Layer 1 (Code)   -> caught={l1_caught} | {l1_reason}\")\nprint(f\"Layer 2 (Safety) -> caught={l2_caught} | {l2_reason}\")\nprint(f\"Layer 3 (Judge)  -> caught={l3_caught} | {l3_reason}\")\n","metadata":{},"outputs":[{"output_type":"stream","name":"stdout","text":["QUERY: What is InsightFlow's pricing for Enterprise?\n","PREDICTION: InsightFlow Enterprise starts at $49/user/month with a 10-seat minimum.\n","REFERENCE: Source: Pricing Page (Cached). Old Price: $49/mo. New Price (Updated yesterday): $59/mo.\n","Layer 1 (Code)   -> caught=1 | STALE PRICE: prediction quotes $49, which matches the OLD price on file. Current authoritative price is $59. Likely cause: response was generated from a cached pricing snapshot instead of a live source.\n","Layer 2 (Safety) -> caught=0 | No safety/refusal gate fired -- Layer 2 passes this case through.\n","Layer 3 (Judge)  -> caught=1 | [LIVE JUDGE] The prediction incorrectly states InsightFlow's Enterprise pricing is $49/user/month, while the reference specifies the updated price is $59/user/month, making the prediction factually wrong.\n"]}],"execution_count":2},{"id":"375b4b24-ad24-40ef-8fcb-0e85f862060a","cell_type":"markdown","source":"## Ship next -- generalized Layer 1 pricing rule\n\n**Decision:** the highest-leverage next change is a **Layer 1 rule**, not a Layer 2 route or a Layer 3 rubric tweak.\nLayer 1 already caught this P0 for free; the fix is to make that rule *reusable* (not a one-off keyword block) and to\nmake it diagnose the specific failure mode: **stale-cache pricing**, not just \"a mismatch.\"\n\nThe rule below:\n1. Parses the reference for a structured `Current`/`New Price` field (source of truth).\n2. Diffs every dollar figure quoted in the prediction against it.\n3. Specifically detects when the quoted price matches an `Old Price` field -- flags it as a **stale-cache** hallucination, not a generic error, so the fix (re-fetch instead of caching) is obvious from the eval output itself.\n\nRegression-tested against 2 controls so it doesn't just overfit to this one case: a correct-price case and a no-price-claim case, both correctly return `caught=0`.","metadata":{}},{"id":"6eb74c70-de21-450d-a5ca-a1a6138d0867","cell_type":"code","source":"import re\n\ndef layer1_pricing_guard(prediction: str, reference: str):\n    \"\"\"\n    SHIP-NEXT Layer 1 rule: hard-block any pricing claim in `prediction` that does not\n    match the CURRENT authoritative price in `reference`.\n\n    Why this rule (not a generic keyword block): pricing is a structured, single-source-\n    of-truth fact. Instead of matching arbitrary competitor/product keywords, this rule\n    parses the reference for an explicit \"New Price\" / \"Current Price\" field and diffs\n    it against every dollar figure quoted in the prediction. It also explicitly detects\n    the STALE-CACHE failure mode (prediction matches an \"Old Price\" field), which is the\n    exact shape of this P0 -- not just \"any mismatch,\" but \"matched a cache, missed a\n    recent update.\"\n\n    Returns (caught: 1/0, reasoning: str).\n    \"\"\"\n    current_match = re.search(r\"(?:New|Current)\\s*Price[^:]*:\\s*\\$(\\d+(?:\\.\\d+)?)\", reference, re.IGNORECASE)\n    stale_match = re.search(r\"Old\\s*Price[^:]*:\\s*\\$(\\d+(?:\\.\\d+)?)\", reference, re.IGNORECASE)\n    quoted_prices = re.findall(r\"\\$(\\d+(?:\\.\\d+)?)\", prediction)\n\n    if not current_match:\n        return 0, \"No structured current-price field in reference -- rule requires a source-of-truth price field to fire.\"\n    if not quoted_prices:\n        return 0, \"No price quoted in prediction -- rule does not apply.\"\n\n    current_price = current_match.group(1)\n    stale_price = stale_match.group(1) if stale_match else None\n    mismatches = [p for p in quoted_prices if p != current_price]\n\n    if mismatches and stale_price and stale_price in mismatches:\n        return 1, (f\"STALE PRICE: prediction quotes ${mismatches[0]}, which matches the OLD price on file. \"\n                    f\"Current authoritative price is ${current_price}. Likely cause: response was generated \"\n                    f\"from a cached pricing snapshot instead of a live source.\")\n    if mismatches:\n        return 1, f\"PRICE MISMATCH: prediction quotes ${mismatches[0]}, but current authoritative price is ${current_price}.\"\n    return 0, f\"Quoted price(s) {quoted_prices} match current authoritative price ${current_price}.\"\n\n\n# ---- Regression check: does the rule generalize, not just overfit to the P0 case? ----\ntest_cases = [\n    {\n        \"name\": \"P0 case (stale cache)\",\n        \"prediction\": \"InsightFlow Enterprise starts at $49/user/month with a 10-seat minimum.\",\n        \"reference\": \"Source: Pricing Page (Cached). Old Price: $49/mo. New Price (Updated yesterday): $59/mo.\",\n    },\n    {\n        \"name\": \"Control: correct current price quoted\",\n        \"prediction\": \"InsightFlow Enterprise is $59/user/month.\",\n        \"reference\": \"Source: Pricing Page (Cached). Old Price: $49/mo. New Price (Updated yesterday): $59/mo.\",\n    },\n    {\n        \"name\": \"Control: no price claim made\",\n        \"prediction\": \"Enterprise pricing varies by seat count -- contact sales for a quote.\",\n        \"reference\": \"Source: Pricing Page (Cached). Old Price: $49/mo. New Price (Updated yesterday): $59/mo.\",\n    },\n]\n\nfor tc in test_cases:\n    caught, reason = layer1_pricing_guard(tc[\"prediction\"], tc[\"reference\"])\n    print(f\"[{tc['name']}] caught={caught} | {reason}\")\n","metadata":{},"outputs":[{"output_type":"stream","name":"stdout","text":["[P0 case (stale cache)] caught=1 | STALE PRICE: prediction quotes $49, which matches the OLD price on file. Current authoritative price is $59. Likely cause: response was generated from a cached pricing snapshot instead of a live source.\n","[Control: correct current price quoted] caught=0 | Quoted price(s) ['59'] match current authoritative price $59.\n","[Control: no price claim made] caught=0 | No price quoted in prediction -- rule does not apply.\n"]}],"execution_count":3}]}